          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Prediction response has valid probability and bands', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('prediction_id');",
                  "    pm.expect(json).to.have.property('risk_probability');",
                  "    pm.expect(json.risk_probability).to.be.at.least(0.0).and.at.most(1.0);",
                  "    pm.expect(['Low', 'Medium', 'High']).to.include(json.risk_level);",
                  "    pm.expect(json).to.have.property('input_features');",
                  "    pm.expect(Object.keys(json.input_features).length).to.eql(16);",
                  "    pm.expect(json).to.have.property('recommendations');",
                  "    pm.environment.set('prediction_id', json.prediction_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
