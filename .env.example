# =============================================================================
# Crop Risk Intelligence Platform - Environment Configuration Template
# =============================================================================
# IMPORTANT: Copy this file to .env for local development.
# NEVER commit real credentials, API keys, or secret tokens to version control.
# =============================================================================

# Application Settings
APP_ENV=development
API_VERSION=v1
DEBUG=false
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated list in production)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501", "http://127.0.0.1:8501"]

# Supabase Infrastructure (Auth + PostgreSQL)
# Required for user authentication, RLS, and farm state persistence
# -----------------------------------------------------------------------------
# BROWSER / CLIENT-SIDE (Next.js Farmer & Expert apps):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
# (Legacy frontend fallback): NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# BACKEND SERVER ONLY (FastAPI services, repositories, migration tools):
# WARNING: NEVER expose SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in frontend code!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# (Legacy backend fallback aliases):
# SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Google OAuth Integration (For web/mobile frontend authentication)
GOOGLE_CLIENT_ID=your-google-client-id-placeholder
GOOGLE_CLIENT_SECRET=your-google-client-secret-placeholder

# Weather Services (Open-Meteo is free & keyless; URL override if proxying)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Model Artifact Locations
RUNTIME_MODEL_BUNDLE_PATH=models/agri_ai_runtime_bundle.pkl
SPECIALIZED_MODELS_DIR=models/specialized
DISTRICT_DATASET_PATH=data/district_dataset.csv

# SMS & WhatsApp Notification Settings (Disabled by default)
SMS_ENABLED=false
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid-placeholder
TWILIO_AUTH_TOKEN=your-twilio-auth-token-placeholder
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=your-approved-content-sid-placeholder

